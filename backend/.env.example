# Copy this file to ".env".
# Database: "sqlite" = the file backend/database/oil_mitra.db (default, no server needed)
#           "mysql"  = a MySQL server, using the DB_* values below
#           "postgres" = an online PostgreSQL (Neon) using DATABASE_URL
DB_TYPE=sqlite

# --- only used when DB_TYPE=mysql ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=oil_mitra_db

# Any long random text. Used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30

# --- Optional "support us" pop-up. Leave the UPI empty to hide it. ---
DONATE_UPI_ID=
DONATE_NAME=OilMitra
DONATE_URL=

# Your username(s), comma separated: they can edit the daily oil rate board.
ADMIN_USERNAMES=

# Google Places + Geocoding key (server-side only, never inside the APK).
# Leave empty to keep using the free OpenStreetMap search.
# Enable "Places API (New)" and "Geocoding API" for the key in Google Cloud.
GOOGLE_MAPS_API_KEY=

# --- Impact maths (used in the app's impact cards) ---
CO2_PER_LITER=2.8
BIODIESEL_YIELD=0.92
